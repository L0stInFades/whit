<Application
    x:Class="Whit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <winui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FF777777</Color>
            <Color x:Key="SystemAccentColorDark1">#FF343434</Color>
            <Color x:Key="SystemAccentColorDark2">#FF262626</Color>
            <Color x:Key="SystemAccentColorDark3">#FF161616</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC3C3C3</Color>
            <Color x:Key="SystemAccentColorLight2">#FFE2E2E2</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF4F4F4</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
