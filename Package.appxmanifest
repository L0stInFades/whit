<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="whit.browser" Publisher="CN=whit." Version="1.0.5.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>whit.</DisplayName>
    <PublisherDisplayName>whit.</PublisherDisplayName>
    <Logo>Assets\Logo50.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.7.0.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources><Resource Language="zh-CN" /></Resources>
  <Applications>
    <Application Id="App" Executable="whit.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="whit." Description="whit." BackgroundColor="transparent"
                          Square44x44Logo="Assets\Logo44.png" Square150x150Logo="Assets\Logo150.png" />
      <Extensions>
        <uap:Extension Category="windows.protocol"><uap:Protocol Name="http" /></uap:Extension>
        <uap:Extension Category="windows.protocol"><uap:Protocol Name="https" /></uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
